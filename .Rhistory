ord <- rda(df.Qs)
plot(ord)
df.demog <- as.data.frame(df.demog)
orddemo <- rda(df.Qs ~ Income, data = df.demog)
plot(orddemo)
summary(orddemo)
anova(orddemo)
colnames(df.demog)
orddemo2 <- rda(df.Qs[-1,] ~ Income*Attained.BS.or.higher+Avg.Literacy.Score+population, data = df.demog[-1,])
plot(orddemo2)
summary(orddemo2)
anova(orddemo2)
